+// FNV-1a 64-bit: hash estável entre execuções e plataformas.
+// std::hash<std::string> é randomizado por sessão em muitos compiladores
+// (seed via ASLR), tornando os IDs irreproduzíveis entre runs.
+uint64_t FNV1a64(const std::string& s) {
+  uint64_t h = 14695981039346656037ULL;
+  for (unsigned char c : s) {
+    h ^= c;
+    h *= 1099511628211ULL;
+  }
+  return h;
+}
